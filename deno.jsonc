{
  "name": "@yozba/scrapbox-url-customizer-extensions",
  "version": "0.1.0",
  "exports": {
    ".": "./mod.ts",
    "./userscript": "./src/main.ts"
  },
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check mod.ts src/main.ts && deno test",
    "fix": "deno fmt && deno lint --fix && deno test"
  },
  "compilerOptions": {
    "lib": [
      "esnext",
      "dom",
      "dom.iterable",
      "deno.ns"
    ]
  },
  "lint": {
    "rules": {
      // Dependency facades use explicit jsr: imports so raw GitHub entry points
      // remain bundleable without this repository's import map.
      "exclude": ["no-import-prefix"]
    }
  }
}
